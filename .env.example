# Copy to .env for local development. Every value below is a safe development default.

# Postgres 16 with the PostGIS extension enabled.
DATABASE_URL="postgresql://chirunama:chirunama@localhost:5432/chirunama"
# Database used by `npm run test:db` and `npm run test:e2e`. Its name must end in _test:
# the test setup drops and recreates its schema on every run.
DATABASE_URL_TEST="postgresql://chirunama:chirunama@localhost:5432/chirunama_test"

# Signs OTP code hashes. At least 32 characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left empty in development, a fixed development value is used and a warning is printed.
AUTH_SECRET=""

# Comma-separated phone numbers that are granted the ADMIN role when they sign in.
ADMIN_PHONES="919000000900"

# Where uploaded photos and documents are written on local disk.
STORAGE_DIR=".data/storage"

# WhatsApp number (country code, no +) that the "message us" links open.
SUPPORT_WHATSAPP="919000000000"

# WhatsApp Cloud API. Leave the token and phone number ID empty in development: messages,
# including sign-in codes, are then only written to the Outbox table and shown at /te/admin/outbox.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v23.0"
# Approved authentication template used for sign-in codes, in Telugu (te) and English (en).
WHATSAPP_OTP_TEMPLATE="chirunama_otp"
