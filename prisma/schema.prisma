// Chirunama data model.
// City and locality are data, never hard-coded, so new cities are added by configuration.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  OWNER
  TENANT
  BUYER
  BROKER
  BUILDER
  VENDOR
  CREATOR
  ADMIN // city ops lead: moderation, broker verification, disputes
  ADVOCATE // advocate partner: signs off document checks
  FIELD_EXECUTIVE // site visits and photos
}

enum Language {
  TE
  EN
}

enum Category {
  RENTAL
  SALE
  PLOT
  COMMERCIAL
}

enum PropertyType {
  HOUSE
  FLAT
  ROOM
  PG
  VILLA
  PLOT
  SHOP
  OFFICE
  GODOWN
}

enum ListerType {
  OWNER
  BROKER
}

enum ListingStatus {
  DRAFT
  PENDING_OTP
  LIVE
  EXPIRED
  CLOSED
  SUSPENDED
}

enum Furnishing {
  UNFURNISHED
  SEMI
  FULL
}

enum LeadSource {
  INSTAGRAM
  WHATSAPP
  FACEBOOK
  NEWSPAPER
  QR
  SITE
}

enum LeadStage {
  NEW
  CONTACTED
  VISIT_BOOKED
  CLOSED
}

enum LeadKind {
  WHATSAPP // tapped the WhatsApp button
  CALL // tapped the call button
  VISIT // asked for a visit through the form
}

enum VerificationType {
  OWNER_VERIFIED
  VERIFIED_BROKER
  DOCUMENTS_CHECKED
  SITE_VISITED
}

enum VerificationResult {
  PENDING
  PASSED
  FAILED
}

enum DocumentKind {
  TITLE
  ENCUMBRANCE
  LAYOUT_APPROVAL
  OWNERSHIP
  OTHER
}

enum BrokerPlan {
  FREE
  PRO
  AGENCY
}

enum FlagSource {
  USER // one-tap report from a buyer or tenant
  AGENT // raised by the Moderation agent
}

enum FlagStatus {
  OPEN
  RESOLVED // action taken
  DISMISSED // nothing wrong
}

enum OutboxChannel {
  WHATSAPP
  SMS
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
  LOGGED // no provider configured: written here for development
}

enum ShareTarget {
  LISTING
  PROFILE
}

enum ActorKind {
  HUMAN
  AGENT
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // verified by OTP; Aadhaar numbers are never stored
  name      String?
  roles     Role[]
  language  Language @default(TE)
  createdAt DateTime @default(now())

  sessions      Session[]
  brokerProfile BrokerProfile?
  listings      Listing[]      @relation("Lister")
  leads         Lead[]         @relation("Enquirer")
  properties    Property[]     @relation("PropertyOwner")
  savedSearches SavedSearch[]
  favorites     Favorite[]
  reviews       Review[]
  flagsRaised   Flag[]         @relation("FlagReporter")
  documents     Document[]
}

// Database sessions: the cookie holds a random token, the table holds its SHA-256.
model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ipHash     String? // sha256 of the requesting IP; raw IPs are never stored
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

model Agency {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique // custom URL on the Agency plan
  plan       BrokerPlan @default(AGENCY)
  logoUrl    String?
  brandColor String?
  createdAt  DateTime   @default(now())

  members BrokerProfile[]
}

model BrokerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])
  slug            String      @unique // /agent/ramesh-realty
  displayName     String
  agencyName      String?
  photoUrl        String?
  bio             String?
  officeAddress   String?
  yearsExperience Int?
  languages       Language[]
  reraNumber      String?
  plan            BrokerPlan  @default(FREE)
  // Plans are free during the launch period; this records a signed commitment to pay after it.
  committedPlan   BrokerPlan?
  committedAt     DateTime?
  verifiedAt      DateTime? // Verified Broker: identity, office and RERA checked by the city ops lead
  verifiedBy      String? // label shown on the badge, e.g. "Ops lead"
  verifiedById    String?
  agencyId        String?
  agency          Agency?     @relation(fields: [agencyId], references: [id])
  localities      Locality[]
  reviews         Review[]
  shareLinks      ShareLink[]
  createdAt       DateTime    @default(now())
}

model City {
  id         String     @id @default(cuid())
  slug       String     @unique
  code       String     @unique // listing code prefix: "TC" for the Tricity
  nameEn     String
  nameTe     String
  // Legal rules (stamp duty, templates, registration) are keyed per state and district.
  state      String
  district   String
  active     Boolean    @default(false)
  lat        Float
  lng        Float
  localities Locality[]
  properties Property[]
}

model Locality {
  id              String                                       @id @default(cuid())
  cityId          String
  city            City                                         @relation(fields: [cityId], references: [id])
  slug            String                                       @unique
  nameEn          String
  nameTe          String
  lat             Float
  lng             Float
  boundary        Unsupported("geometry(MultiPolygon, 4326)")?
  // Locality price index: plain averages of live listings, recomputed by a job.
  avgRentPerMonth Int?
  avgSalePerSqft  Int?
  avgPlotPerSqyd  Int?
  avgUpdatedAt    DateTime?

  properties Property[]
  brokers    BrokerProfile[]

  @@unique([cityId, slug])
}

// One building, many units (flats, shops).
model Property {
  id            String         @id @default(cuid())
  cityId        String
  city          City           @relation(fields: [cityId], references: [id])
  localityId    String
  locality      Locality       @relation(fields: [localityId], references: [id])
  ownerId       String?
  owner         User?          @relation("PropertyOwner", fields: [ownerId], references: [id])
  address       String?
  lat           Float?
  lng           Float?
  units         Unit[]
  verifications Verification[]
  createdAt     DateTime       @default(now())
}

model Unit {
  id         String       @id @default(cuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id])
  type       PropertyType
  label      String? // "Flat 302", "Shop 4"
  bhk        Int?
  areaSqft   Int?
  areaSqyd   Int? // plots are measured in sq. yards
  floor      Int?
  facing     String?
  listings   Listing[]
}

model Listing {
  id                 String        @id @default(cuid())
  number             Int           @unique @default(autoincrement())
  code               String        @unique // "TC-1042", printed on classifieds and QR boards
  unitId             String
  unit               Unit          @relation(fields: [unitId], references: [id])
  category           Category
  listerId           String
  lister             User          @relation("Lister", fields: [listerId], references: [id])
  listerType         ListerType
  status             ListingStatus @default(DRAFT)
  titleEn            String
  titleTe            String
  descriptionEn      String?
  descriptionTe      String?
  price              Int // rupees: monthly rent for rentals, total price otherwise
  deposit            Int?
  furnishing         Furnishing?
  // Category-specific fields, validated by src/lib/listing-schema.ts.
  details            Json          @default("{}")
  photos             String[] // storage keys
  allowBrokerContact Boolean       @default(true)
  availableFrom      DateTime?
  views              Int           @default(0)
  lastConfirmedAt    DateTime      @default(now()) // listings expire unless re-confirmed
  reminderSentAt     DateTime? // "is it still available?" nudge before expiry
  intakeSource       String? // form, whatsapp text, post link, newspaper photo
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  leads         Lead[]
  verifications Verification[]
  shareLinks    ShareLink[]
  favorites     Favorite[]
  flags         Flag[]

  @@index([category, status])
}

model Lead {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id])
  enquirerId    String?
  enquirer      User?      @relation("Enquirer", fields: [enquirerId], references: [id])
  enquirerName  String?
  enquirerPhone String?
  kind          LeadKind   @default(WHATSAPP)
  source        LeadSource
  shareLinkId   String?
  shareLink     ShareLink? @relation(fields: [shareLinkId], references: [id])
  stage         LeadStage  @default(NEW)
  message       String?
  visitAt       DateTime?
  reminderAt    DateTime? // when the visit reminder went out
  contactedAt   DateTime? // first move past NEW: feeds the broker's response time
  review        Review?
  createdAt     DateTime   @default(now())

  @@index([listingId, createdAt])
}

model Verification {
  id         String             @id @default(cuid())
  type       VerificationType
  listingId  String?
  listing    Listing?           @relation(fields: [listingId], references: [id])
  propertyId String?
  property   Property?          @relation(fields: [propertyId], references: [id])
  documents  Document[]
  // Gap checklist from the Document agent: [{ item, status, note }].
  checklist  Json               @default("[]")
  notes      String? // what the reviewer says is missing
  reviewer   String? // advocate partner, ops lead or field executive, as shown on the badge
  reviewerId String?
  result     VerificationResult @default(PENDING)
  checkedAt  DateTime?
  createdAt  DateTime           @default(now())

  @@index([type, result])
}

model Document {
  id             String       @id @default(cuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  kind           DocumentKind
  storageKey     String       @unique
  fileName       String
  mimeType       String
  size           Int
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
}

model SavedSearch {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters       Json // ListingFilters
  language      Language  @default(TE)
  whatsappOptIn Boolean   @default(false) // explicit opt-in before any WhatsApp alert
  active        Boolean   @default(true)
  lastAlertAt   DateTime?
  createdAt     DateTime  @default(now())
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// Reviews only from people who contacted the broker through the platform.
model Review {
  id              String        @id @default(cuid())
  brokerProfileId String
  brokerProfile   BrokerProfile @relation(fields: [brokerProfileId], references: [id])
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  leadId          String        @unique
  lead            Lead          @relation(fields: [leadId], references: [id])
  rating          Int
  text            String?
  createdAt       DateTime      @default(now())
}

// Moderation queue: one-tap reports and Moderation agent flags.
model Flag {
  id           String     @id @default(cuid())
  listingId    String?
  listing      Listing?   @relation(fields: [listingId], references: [id])
  source       FlagSource
  kind         String // DUPLICATE, BROKER_AS_OWNER, ODD_PRICE, SOLD, FAKE, WRONG_DETAILS, OTHER
  detail       String?
  reporterId   String?
  reporter     User?      @relation("FlagReporter", fields: [reporterId], references: [id])
  status       FlagStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

// Every outgoing WhatsApp or SMS message, sent or (in development) only logged.
model Outbox {
  id                String        @id @default(cuid())
  channel           OutboxChannel
  to                String
  template          String? // approved WhatsApp template name
  params            Json? // template parameters, with secrets such as OTP codes redacted
  language          Language?
  body              String // with secrets such as OTP codes redacted
  status            OutboxStatus  @default(QUEUED)
  error             String?
  attempts          Int           @default(0)
  providerMessageId String?
  purpose           String // otp, lead, visit_reminder, saved_search, expiry_reminder
  createdAt         DateTime      @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

model ShareLink {
  id              String         @id @default(cuid())
  code            String         @unique // /s/<code>
  target          ShareTarget
  listingId       String?
  listing         Listing?       @relation(fields: [listingId], references: [id])
  brokerProfileId String?
  brokerProfile   BrokerProfile? @relation(fields: [brokerProfileId], references: [id])
  channel         LeadSource
  clicks          Int            @default(0)
  leads           Lead[]
  createdAt       DateTime       @default(now())

  @@unique([target, listingId, brokerProfileId, channel])
}

model AuditEvent {
  id        String    @id @default(cuid())
  actorKind ActorKind
  actor     String // user id or agent name
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
